# Локальная разработка backend без Docker. В docker-compose значения приходят из
# корневого .env — этот файл нужен только для запуска через `uv run` на машине.

APP_ENV=development
DEBUG=true

SECRET_KEY=dev_secret_key_change_me
JWT_SECRET_KEY=dev_jwt_secret_change_me
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30

DATABASE_URL=postgresql+asyncpg://pulse:pulse_dev_password@localhost:5432/pulse_shop
# Отдельная база для тестов. Пустое значение — интеграционные тесты пропускаются.
TEST_DATABASE_URL=

REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

STORAGE_DRIVER=local
MEDIA_ROOT=./media
PUBLIC_BASE_URL=http://localhost:8000

# Заполняются только при STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pulse-media

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@pulse.local
EMAILS_ENABLED=false

PAYMENT_PROVIDER=fake
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=dev_webhook_secret

FRONTEND_BASE_URL=http://localhost:5173
API_INTERNAL_URL=http://localhost:8000