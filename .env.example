# ─────────────────────────────────────────────────────────────
# ПУЛЬС — интернет-магазин компьютерных комплектующих
# Корневой пример переменных окружения для Docker Compose.
# Скопируйте в .env:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me
PUBLIC_BASE_URL=http://localhost:8090

# ── База данных (раздел 20 ТЗ) ───────────────────────────────
POSTGRES_DB=pulse_shop
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password
DATABASE_URL=postgresql+asyncpg://pulse:pulse_dev_password@db:5432/pulse_shop
# Отдельная база для тестов — её создаёт `make test-db`.
TEST_DATABASE_URL=postgresql+asyncpg://pulse:pulse_dev_password@db:5432/pulse_test

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT (раздел 20 ТЗ) ───────────────────────────────────────
JWT_SECRET_KEY=change_me
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8090,http://localhost:5173

# ── Хранилище изображений ────────────────────────────────────
# local — файлы на томе Docker, раздаёт backend с /media (рекомендуется в dev).
# s3    — S3-совместимое хранилище через boto3: MinIO, YOS, AWS S3.
STORAGE_DRIVER=local
MEDIA_ROOT=/app/media
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pulse-media

# ── SMTP (email; в dev отключено — письма пишутся в лог) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@pulse.local
EMAILS_ENABLED=false

# ── Платежи (MVP: фейковый провайдер) ────────────────────────
PAYMENT_PROVIDER=fake
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=change_me

# ── Frontend (SSR) ───────────────────────────────────────────
FRONTEND_PORT=3000
# Адрес API, доступный frontend-контейнеру изнутри docker-сети.
API_INTERNAL_URL=http://backend:8000

# ── Порты, публикуемые на хосте ──────────────────────────────
# Внутренние порты контейнеров фиксированы; на хосте подобраны так, чтобы
# не конфликтовать с другими локальными стеками (5432/6379/8000 часто заняты).
HOST_WEB_PORT=8090
HOST_BACKEND_PORT=8010
HOST_DB_PORT=5433
HOST_REDIS_PORT=6380